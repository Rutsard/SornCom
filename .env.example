# ==============================================================================
# Modern Online Judge & Python Learning Platform (programming.in.th inspired)
# Environment Configuration
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Core Database (PostgreSQL - Port 5432)
# Handles: Users, Authentication, Tracks (POSN / Eng), Lessons, Progress Tracking
# ------------------------------------------------------------------------------
CORE_DB_USER=core_admin
CORE_DB_PASSWORD=core_secure_password_9921
CORE_DB_NAME=core_db
CORE_DB_PORT=5432
CORE_DATABASE_URL="postgresql://core_admin:core_secure_password_9921@localhost:5432/core_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Judge Database (PostgreSQL - Port 5433)
# Handles: Problem Statements, Test Cases, Submissions, Grading Verdicts (P, -, T, X)
# ------------------------------------------------------------------------------
JUDGE_DB_USER=judge_admin
JUDGE_DB_PASSWORD=judge_secure_password_9921
JUDGE_DB_NAME=judge_db
JUDGE_DB_PORT=5433
JUDGE_DATABASE_URL="postgresql://judge_admin:judge_secure_password_9921@localhost:5433/judge_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Queue & Cache (Redis - Port 6379)
# Handles: Real-time submission queue, rate limiting, and result pub/sub
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Server-Side Auto Grader (Judge0 CE - Port 2358)
# ------------------------------------------------------------------------------
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_AUTH_TOKEN=""
