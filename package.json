{
  "name": "online-judge-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate:core": "prisma generate --schema=prisma/core.prisma",
    "prisma:generate:judge": "prisma generate --schema=prisma/judge.prisma",
    "prisma:generate": "npm run prisma:generate:core && npm run prisma:generate:judge",
    "prisma:push:core": "prisma db push --schema=prisma/core.prisma",
    "prisma:push:judge": "prisma db push --schema=prisma/judge.prisma",
    "prisma:push": "npm run prisma:push:core && npm run prisma:push:judge",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.21.1",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
